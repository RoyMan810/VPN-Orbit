{
  "application": "VPN-Orbit",
  "version": "0.1.0.dev1",
  "channel": "development",
  "sqlite_schema": 6,
  "sqlite_compatibility": {
    "authentication": [
      6
    ],
    "observation_queue": [
      6
    ]
  },
  "password_profile": {
    "version": 1,
    "algorithm": "argon2id",
    "time_cost": 3,
    "memory_cost_kib": 65536,
    "parallelism": 4,
    "hash_len": 32,
    "salt_len": 16
  },
  "capabilities": [
    "owner_auth",
    "scoped_rbac",
    "sqlite_audit_outbox"
  ],
  "remote_mutation_enabled": false
}
