#!/usr/bin/python3 -I
"""Forced command for the fixed VPN-Orbit observation capability."""
import os
import signal
import subprocess
import sys


def main():
    if len(sys.argv) != 1 or os.environ.get("SSH_ORIGINAL_COMMAND") != "vpn-orbit.v16.probe":
        return 65
    request = b'{"operation":"probe","version":16}\n'
    signal.alarm(5)
    payload = sys.stdin.buffer.read(len(request) + 1)
    signal.alarm(0)
    if payload != request:
        return 65
    try:
        return subprocess.run(["/usr/bin/sudo", "-n", "--", "/usr/local/libexec/vpn-orbit/typed-helper"],
                              input=request, timeout=10, env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"}).returncode
    except (OSError, subprocess.SubprocessError):
        return 70


if __name__ == "__main__":
    raise SystemExit(main())
