# Debian 13 (trixie) amd64, published 2026-11-23: https://docker.debian.net/
FROM docker.io/library/debian@sha256:1c2fd3096624441883bc13fd646c376664b3ee8a990fde0f6246e567349512e9
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd-sysv openssh-server sudo python3 \
 && useradd --create-home --shell /bin/sh fixtureadmin \
 && printf 'fixtureadmin ALL=(root) ALL\n' > /etc/sudoers.d/vpn-orbit-lab \
 && chmod 0440 /etc/sudoers.d/vpn-orbit-lab \
 && systemctl enable ssh.service \
 && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
