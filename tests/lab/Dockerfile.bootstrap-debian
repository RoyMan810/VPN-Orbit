# Debian 13 (trixie) amd64, published 2026-11-23: https://docker.debian.net/
FROM docker.io/library/debian@sha256:1c2fd3096624441883bc13fd646c376664b3ee8a990fde0f6246e567349512e9
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates git initramfs-tools iproute2 linux-image-amd64 openssh-server python3 systemd-sysv udev \
 && systemctl enable ssh.service systemd-networkd.service \
 && rm -f /etc/ssh/ssh_host_* \
 && rm -rf /var/lib/apt/lists/*
